cff-version: 1.2.0
message: >-
  If you use this software, please cite it and acknowledge the methods and
  libraries listed in README.md and NOTICE.
title: "tnpinn (TPINN)"
type: software
authors:
  - family-names: Mata Ali
    given-names: Alejandro
    email: alejandro.mata.ali@gmail.com
license: MIT
repository-code: "https://github.com/DOKOS-TAYOS/TPINN"
abstract: >-
  Physics-informed neural networks based on differentiable tensor networks,
  with optional MLP and SIREN baselines.
keywords:
  - physics-informed neural networks
  - tensor networks
  - PINN
  - TensorKrowch
  - PyTorch
references:
  - type: article
    title: "Implicit Neural Representations with Periodic Activation Functions"
    authors:
      - family-names: Sitzmann
        given-names: Vincent
      - family-names: Martel
        given-names: Julien N. P.
      - family-names: Bergman
        given-names: Alexander W.
